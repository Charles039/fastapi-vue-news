# 环境变量示例；请通过 IDE、PowerShell、容器或部署平台注入。
DEBUG_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQL Server 异步连接地址；请按实际服务器和密码修改。
DATABASE_URL=mssql+aioodbc://localhost:1433/news?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes&trusted_connection=yes

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1
